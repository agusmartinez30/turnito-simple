NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://app:app@localhost:5441/turnito_simple
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3000
# Must match MAX_DAYS_AHEAD in the web app
BOOKING_MAX_DAYS_AHEAD=7
# true behind a reverse proxy (uses X-Forwarded-For for the rate limit)
TRUST_PROXY=false
# Uploaded files (complex logo, payment proofs). `stub` = in-memory Map, no persistence (dev/tests);
# `supabase` = Supabase Storage buckets
STORAGE_PROVIDER=stub
# Required with supabase. service_role bypasses RLS for the whole project: server only, never NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complex-logos
# PRIVATE bucket (do not make it public): payment proofs, read through signed URLs
SUPABASE_PAYMENT_PROOFS_BUCKET=payment-proofs

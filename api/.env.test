NODE_ENV=test
PORT=3002
DATABASE_URL=postgresql://app:app@localhost:5441/turnito_simple_test
# At least 32 characters. Test-only value, not a real secret.
JWT_SECRET=test-only-secret-turnito-simple-0123456789abcdef
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3000
# Must match MAX_DAYS_AHEAD in the web app
BOOKING_MAX_DAYS_AHEAD=7
# true behind a reverse proxy (uses X-Forwarded-For for the rate limit)
TRUST_PROXY=true
# Storage: in-memory provider, no real bucket
STORAGE_PROVIDER=stub
